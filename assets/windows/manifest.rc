#define RT_MANIFEST 24
1 RT_MANIFEST "manifest.xml"
2 ICON "../icon.ico"

1 VERSIONINFO
FILEVERSION SLOTHARBOR_VERSION_PARTS
PRODUCTVERSION SLOTHARBOR_VERSION_PARTS
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "SlotHarbor - Game Save Backup\0"
            VALUE "FileVersion", SLOTHARBOR_VERSION_STRING
            VALUE "ProductVersion", SLOTHARBOR_VERSION_STRING
            VALUE "ProductName", "SlotHarbor\0"
            VALUE "OriginalFilename", "slotharbor.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
